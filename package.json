{
  "name": "automatizacion-playwright",
  "version": "1.0.0",
  "description": "Professional automation framework with TypeScript, Cucumber, Serenity/JS and Playwright",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:cucumber": "cucumber-js",
    "test:api": "cucumber-js --config cucumber-api.mjs",
    "test:api:smoke": "cucumber-js --config cucumber-api.mjs --tags @smoke",
    "test:playwright": "playwright test",
    "test:all": "pnpm test:cucumber && pnpm test:api && pnpm test:playwright",
    "typecheck": "tsc --noEmit",
    "test:report": "pnpm exec html-reporter serve --dir ./reports/serenity-js --open",
    "test:report:api": "pnpm exec html-reporter serve --dir ./reports/serenity-js-api --open"
  },
  "keywords": [
    "automation",
    "cucumber",
    "playwright",
    "screenplay",
    "serenity-js",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@playwright/test": "^1.63.0",
    "@serenity-js/assertions": "3.48.0",
    "@serenity-js/console-reporter": "3.48.0",
    "@serenity-js/core": "3.48.0",
    "@serenity-js/cucumber": "3.48.0",
    "@serenity-js/html-reporter": "3.48.0",
    "@serenity-js/playwright": "3.48.0",
    "@serenity-js/web": "3.48.0",
    "@types/node": "^24.13.6",
    "playwright": "^1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@serenity-js/rest": "3.48.0",
    "axios": "^1.20.0"
  }
}
